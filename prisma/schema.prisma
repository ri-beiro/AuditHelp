// Modelo de dados do sistema WISE.
// Estrutura pensada para crescer: "Framework" identifica a metodologia avaliada
// (WISE, 12 Básicos e, no futuro, outros protocolos de auditoria), e as tabelas de
// avaliação, evidência e plano de ação são genéricas por requisito.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  ADMIN
  AUDITOR
  RESPONSAVEL
}

enum Framework {
  WISE
  BASICS
}

enum ElementStatus {
  NAO_INICIADO
  EM_ANDAMENTO
  CONCLUIDO
}

enum EvidenceKind {
  FILE
  LINK
}

enum ActionPriority {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

enum ActionStatus {
  ABERTA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

enum IncidentType {
  FATALIDADE
  LTA
  NLTA
  FAC
  INCIDENTE
  NEAR_MISS
  CONDICAO_INSEGURA
  OBSERVACAO
}

enum StepStatus {
  NAO_INICIADO
  EM_ANDAMENTO
  AGENDADO
  CONCLUIDO
}

enum AuditStatus {
  EM_ANDAMENTO
  CONCLUIDA
}

// ---------------------------------------------------------------------------
// Organização e usuários
// ---------------------------------------------------------------------------

model Unit {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  city      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  members     UnitMember[]
  assessments Assessment[]
  actionPlans ActionPlan[]
  snapshots   ScoreSnapshot[]
  audits      Audit[]
  incidents   Incident[]
  auditRecords AuditRecord[]

  // Data base do contador "Dias sem acidentes" quando ainda não há acidente registrável
  safetyStartDate DateTime?
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(RESPONSAVEL)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  units               UnitMember[]
  responsibleElements ElementAssessment[] @relation("ElementResponsible")
  updatedElements     ElementAssessment[] @relation("ElementUpdatedBy")
  scores              RequirementScore[]
  evidences           Evidence[]
  ownedActions        ActionPlan[]        @relation("ActionOwner")
  createdActions      ActionPlan[]        @relation("ActionCreator")
  assessments         Assessment[]
  closingReports      ClosingReport[]
  audits              Audit[]             @relation("AuditAuditor")
  auditAnswers        AuditAnswer[]
  auditAttachments    AuditAttachment[]
  responsibleIncidents Incident[]         @relation("IncidentResponsible")
  reportedIncidents    Incident[]         @relation("IncidentReporter")
  approvedIncidents    Incident[]         @relation("IncidentApprover")
  incidentAttachments  IncidentAttachment[]
  auditRecords         AuditRecord[]
}

model UnitMember {
  userId String
  unitId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([userId, unitId])
}

// ---------------------------------------------------------------------------
// Catálogo (matrizes)
// ---------------------------------------------------------------------------

model Pillar {
  id        String    @id @default(cuid())
  framework Framework
  name      String
  order     Int
  color     String

  elements Element[]

  @@unique([framework, name])
}

model Element {
  id          String    @id @default(cuid())
  framework   Framework
  number      Int
  code        String    @unique // W1..W13, B1..B12
  name        String
  shortName   String
  description String
  objective   String
  glossary    String?
  icon        String
  pillarId    String
  pillar      Pillar    @relation(fields: [pillarId], references: [id])

  requirements       Requirement[]
  elementAssessments ElementAssessment[]
  evidences          Evidence[]
  actionPlans        ActionPlan[]

  @@unique([framework, number])
}

model Requirement {
  id        String  @id @default(cuid())
  elementId String
  element   Element @relation(fields: [elementId], references: [id], onDelete: Cascade)
  code      String  @unique
  order     Int
  text      String

  // WISE: nível de maturidade (1-5) e dimensão (ATIVIDADE | QUALIDADE | IMPACTO)
  level     Int?
  dimension String?

  // 12 Básicos: nível de risco (1 = crítico) e critérios Básico/Parcial/Significativo
  riskLevel Int?
  criteria  Json?

  evidenceHint String?

  scores      RequirementScore[]
  evidences   Evidence[]
  actionPlans ActionPlan[]

  @@index([elementId])
}

// ---------------------------------------------------------------------------
// Avaliações
// ---------------------------------------------------------------------------

model Assessment {
  id          String    @id @default(cuid())
  unitId      String
  unit        Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  framework   Framework
  cycle       String // ex.: "2026"
  createdAt   DateTime  @default(now())
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  elements    ElementAssessment[]
  scores      RequirementScore[]
  evidences   Evidence[]
  actionPlans ActionPlan[]
  report      ClosingReport?

  @@unique([unitId, framework, cycle])
}

model ElementAssessment {
  id              String         @id @default(cuid())
  assessmentId    String
  assessment      Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  elementId       String
  element         Element        @relation(fields: [elementId], references: [id], onDelete: Cascade)
  responsibleId   String?
  responsible     User?          @relation("ElementResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  status          ElementStatus?
  summary         String?
  recommendations String?
  updatedAt       DateTime       @updatedAt
  updatedById     String?
  updatedBy       User?          @relation("ElementUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([assessmentId, elementId])
}

model RequirementScore {
  id            String      @id @default(cuid())
  assessmentId  String
  assessment    Assessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  // WISE: "0" | "1" | "2"   —   Básicos: "BASIC" | "PARTIAL" | "SIGNIFICANT" | "COMPLIANT" | "NA"
  value         String?
  observation   String?
  updatedAt     DateTime    @updatedAt
  updatedById   String?
  updatedBy     User?       @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([assessmentId, requirementId])
}

model Evidence {
  id            String       @id @default(cuid())
  assessmentId  String
  assessment    Assessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  elementId     String
  element       Element      @relation(fields: [elementId], references: [id], onDelete: Cascade)
  requirementId String?
  requirement   Requirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  kind          EvidenceKind
  name          String
  url           String
  mimeType      String?
  size          Int?
  description   String?
  uploadedById  String?
  uploadedBy    User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())

  @@index([assessmentId, elementId])
}

// Plano de ação no modelo 5W2H
model ActionPlan {
  id            String         @id @default(cuid())
  unitId        String
  unit          Unit           @relation(fields: [unitId], references: [id], onDelete: Cascade)
  assessmentId  String?
  assessment    Assessment?    @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  elementId     String
  element       Element        @relation(fields: [elementId], references: [id], onDelete: Cascade)
  requirementId String?
  requirement   Requirement?   @relation(fields: [requirementId], references: [id], onDelete: SetNull)

  what     String // O quê?
  why      String? // Por quê?
  ownerId  String? // Quem?
  owner    User?     @relation("ActionOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  dueDate  DateTime? // Quando?
  where    String? // Onde?
  how      String? // Como?
  cost     Decimal?  @db.Decimal(12, 2) // Quanto?

  spheraId      String? // ID do finding / evento no Sphera
  auditId       String?
  audit         Audit?   @relation(fields: [auditId], references: [id], onDelete: SetNull)
  auditItemCode String?
  incidentId    String?
  incident      Incident?    @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  auditRecordId String?
  auditRecord   AuditRecord? @relation(fields: [auditRecordId], references: [id], onDelete: SetNull)
  evidence      String? // evidência de conclusão (texto ou link)

  priority    ActionPriority @default(MEDIA)
  status      ActionStatus   @default(ABERTA)
  completedAt DateTime?
  createdById String?
  createdBy   User?          @relation("ActionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([unitId, status])
}

// Fotografia mensal das pontuações, usada no gráfico de evolução.
// scope = "OVERALL" ou o código do elemento (W1, B3...).
model ScoreSnapshot {
  id        String    @id @default(cuid())
  unitId    String
  unit      Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  framework Framework
  scope     String
  month     String // "2026-09"
  score     Float?
  percent   Float?
  updatedAt DateTime  @updatedAt

  @@unique([unitId, framework, scope, month])
}

// Relatório da reunião de fechamento da auditoria WISE² (um por avaliação WISE da unidade/ciclo).
// Estrutura conforme o Treinamento de Auditor Júnior (slides 104–129).
model ClosingReport {
  id           String     @id @default(cuid())
  assessmentId String     @unique
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  auditDates   String?
  auditors     String?
  format       String?
  highlights   String?
  quotes       String?
  // { "Liderança": { "strengths": "...", "opportunities": "..." }, ... }
  groups       Json?
  conclusion   String?
  updatedAt    DateTime   @updatedAt
  updatedById  String?
  updatedBy    User?      @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

// ---------------------------------------------------------------------------
// Módulo Auditorias — checklists de empresas contratadas (Portaria, Limpeza...)
// Os itens do checklist ficam em src/lib/audit-templates.ts (template + itemCode).
// ---------------------------------------------------------------------------

model Audit {
  id            String      @id @default(cuid())
  unitId        String
  unit          Unit        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  template      String
  contractor    String
  auditDate     DateTime
  auditorId     String?
  auditor       User?       @relation("AuditAuditor", fields: [auditorId], references: [id], onDelete: SetNull)
  accompaniedBy String?
  status        AuditStatus @default(EM_ANDAMENTO)
  strengths     String?
  opportunities String?
  conclusion    String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  answers     AuditAnswer[]
  attachments AuditAttachment[]
  actionPlans ActionPlan[]

  @@index([unitId, template])
}

model AuditAnswer {
  id          String   @id @default(cuid())
  auditId     String
  audit       Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  itemCode    String
  value       String? // "C" | "NC" | "NA"
  observation String?
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([auditId, itemCode])
}

model AuditAttachment {
  id           String   @id @default(cuid())
  auditId      String
  audit        Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  itemCode     String?
  name         String
  url          String
  mimeType     String?
  size         Int?
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Ocorrências de segurança e investigação (pirâmide de Heinrich/Bird)
// Fluxo: Reporte → Investigação (agenda) → Plano de ação → Lições aprendidas → Encerramento
// ---------------------------------------------------------------------------

model Incident {
  id          String       @id @default(cuid())
  unitId      String
  unit        Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  number      String       @unique // OC-2026-0001
  occurredAt  DateTime
  area        String
  type        IncidentType
  hipo        Boolean      @default(false)
  title       String
  description String
  spheraId    String?
  responsibleId String?
  responsible   User?      @relation("IncidentResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  reportedById  String?
  reportedBy    User?      @relation("IncidentReporter", fields: [reportedById], references: [id], onDelete: SetNull)

  // Etapa 1 — Reporte
  reportStatus StepStatus @default(EM_ANDAMENTO)

  // Etapa 2 — Agenda de investigação
  investigationStatus StepStatus @default(NAO_INICIADO)
  meetingAt           DateTime?
  participants        String?
  meetingNotes        String? // ata

  // Etapa 3 — Plano de ação (ações em ActionPlan.incidentId)
  planStatus StepStatus @default(NAO_INICIADO)

  // Etapa 4 — Lições aprendidas
  lessonsStatus  StepStatus @default(NAO_INICIADO)
  rootCause      String?
  whatHappened   String?
  howToPrevent   String?
  goodPractices  String?
  sharedWith     String?
  approvedById   String?
  approvedBy     User?      @relation("IncidentApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt     DateTime?

  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  attachments IncidentAttachment[]
  actionPlans ActionPlan[]

  @@index([unitId, occurredAt])
}

model IncidentAttachment {
  id           String   @id @default(cuid())
  incidentId   String
  incident     Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  name         String
  url          String
  mimeType     String?
  size         Int?
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
}

// Histórico de auditorias registradas manualmente (WISE, 12 Básicos, internas, externas...).
// As auditorias de contratadas feitas no sistema entram no histórico automaticamente.
model AuditRecord {
  id          String   @id @default(cuid())
  unitId      String
  unit        Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  date        DateTime
  type        String
  area        String
  auditor     String
  score       Float
  maxScore    Float    @default(100)
  result      String?
  reportUrl   String?
  notes       String?
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  actionPlans ActionPlan[]

  @@index([unitId, date])
}
