# PostgreSQL (Neon / Supabase / Vercel Postgres). Use a URL "pooled" em DATABASE_URL
# e a conexão direta em DATABASE_URL_UNPOOLED (necessária para migrations).
# Na Vercel, o banco Neon do Marketplace já cria essas duas variáveis automaticamente.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wise?schema=public"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/wise?schema=public"

# Auth.js — gere com: npx auth secret  (ou openssl rand -base64 32)
AUTH_SECRET="troque-este-valor"

# Vercel Blob — criado automaticamente ao conectar um Blob Store ao projeto na Vercel.
# Sem ele, em desenvolvimento os arquivos são salvos em public/uploads.
BLOB_READ_WRITE_TOKEN=""

# Usuário administrador criado pelo seed
SEED_ADMIN_EMAIL="admin@wise.local"
SEED_ADMIN_PASSWORD="Wise@2026"
